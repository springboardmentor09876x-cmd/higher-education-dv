    <worksheet name='Top 10 Universities by Citations Count'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Georgia' fontsize='16'>TOP 10 UNIVERSITIES BY CITATIONS COUNT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Merged_Data (university_final_dataset  )' name='federated.0aejqxu0wkzdzg178gtqe11xn91o' />
          </datasources>
          <datasource-dependencies datasource='federated.0aejqxu0wkzdzg178gtqe11xn91o'>
            <column caption='Citations Count' datatype='integer' name='[citations_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <semantic-values semantic-role='[Country].[Name]'>
                <semantic-value key='&quot;China (Mainland)&quot;' value='&quot;China&quot;' />
              </semantic-values>
            </column>
            <column caption='Degree Level' datatype='string' name='[degree_level]' role='dimension' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[degree_level]' derivation='None' name='[none:degree_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[subject_field]' derivation='None' name='[none:subject_field:nk]' pivot='key' type='nominal' />
            <column-instance column='[university_name]' derivation='None' name='[none:university_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Research Productivity Index' datatype='real' name='[research_productivity_index]' role='measure' type='quantitative' />
            <column caption='Subject Field' datatype='string' name='[subject_field]' role='dimension' type='nominal' />
            <column-instance column='[citations_count]' derivation='Sum' name='[sum:citations_count:qk]' pivot='key' type='quantitative' />
            <column caption='University Name' datatype='string' name='[university_name]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0aejqxu0wkzdzg178gtqe11xn91o].[none:country:nk]' filter-group='7'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([research_productivity_index])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:country:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0aejqxu0wkzdzg178gtqe11xn91o].[none:degree_level:nk]' filter-group='9'>
            <groupfilter function='member' level='[none:degree_level:nk]' member='&quot;Undergraduate &amp; Postgraduate&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
