            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Research Productivity Index' datatype='real' name='[research_productivity_index]' role='measure' type='quantitative' />
            <column-instance column='[international_student_ratio]' derivation='Sum' name='[sum:international_student_ratio:qk]' pivot='key' type='quantitative' />
            <column-instance column='[international_students_count]' derivation='Sum' name='[sum:international_students_count:qk]' pivot='key' type='quantitative' />
